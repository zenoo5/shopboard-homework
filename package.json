{
  "name": "respawn-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A beginner-friendly gaming storefront built with vanilla TypeScript modules.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:compile": "tsc --noEmit false --declaration false --declarationMap false --sourceMap false --rootDir src --outDir .test-build",
    "test": "npm run test:compile && node --test tests/*.test.js",
    "test:core": "npm run test:compile && node --test tests/core.test.js",
    "test:ui": "npm run test:compile && node --test tests/ui.test.js",
    "test:watch": "npm run test:compile && node --test --watch tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run lint && npm run format:check && npm run build",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vite": "^7.1.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,html,css,json,md,svg}": "prettier --write"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
